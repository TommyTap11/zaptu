HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ZAPTU_DATA_DIR=./data
# Legacy alias still accepted:
# DATA_DIR=./data

# Protect REST admin routes. Leave empty to keep local MVP open.
API_TOKEN=

# Optional live sink (Zapier / Make / network webhook)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Mock buyer is OFF by default. Set to 1 only for local demos.
ZAPTU_MOCK_FORWARDER=0
# Legacy alias (also defaults off now):
MOCK_FORWARDING=false
REQUIRE_CONSENT=true

PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=https://zaptu.ai,https://www.zaptu.ai
RATE_LIMIT_PER_MINUTE=30
THANKS_URL=https://zaptu.ai/thanks
