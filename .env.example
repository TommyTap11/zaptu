HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data

# Protect REST admin routes. Leave empty to keep local MVP open.
API_TOKEN=

# Optional live sink (Zapier / Make / network webhook)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Simulate a buyer network so the product works before affiliate approval
MOCK_FORWARDING=true
REQUIRE_CONSENT=true

PUBLIC_BASE_URL=http://localhost:8000
