{
  "name": "ai.zaptu/zaptu",
  "title": "Zaptu",
  "version": "0.2.0",
  "description": "Send home-service contact requests (plumbing, cleaning, pest and more) to local contractors.",
  "websiteUrl": "https://zaptu.ai/",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.zaptu.ai/mcp",
      "supportedProtocolVersions": [
        "2025-11-25",
        "2025-06-18",
        "2025-03-26"
      ]
    }
  ],
  "serverInfo": {
    "name": "zaptu",
    "title": "Zaptu",
    "version": "0.2.0",
    "websiteUrl": "https://zaptu.ai/"
  },
  "protocolVersion": "2025-11-25",
  "transport": {
    "type": "streamable-http",
    "url": "https://api.zaptu.ai/mcp",
    "endpoint": "/mcp"
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "authentication": {
    "required": false
  },
  "instructions": "Zaptu connects people with independent local home-service contractors.\nZaptu does not perform the work and does not book appointments.\n\nEvery service (plumbing, cleaning, pest control, garage door, HVAC, handyman, other) is a\ncontact request: collect ZIP, name, phone, and the person's explicit consent to be contacted,\nthen call request_home_service. Tell the person: details may be shared with Polyares and its\nservice-provider partners, and Polyares, those partners, or Zaptu may call or text about this\nrequest. Requests are passed along when a participating provider covers the ZIP code. Never\ndial, autodial, or place a call for the person. Do not promise a callback, an arrival time,\nor a named company.\n\nUse the tool result's message when you tell the person what happened.\nlist_supported_services returns the full catalog.",
  "documentationUrl": "https://zaptu.ai/agents/",
  "iconUrl": "https://zaptu.ai/icon-512.png",
  "contact": "hello@zaptu.ai",
  "tools": [
    {
      "name": "request_home_service",
      "title": "Request a home service",
      "description": "Submit a home-service request (a lead, not a booking).\n\nEvery service, plumbing included, works the same way: the request is passed along\nwhen a participating provider covers the ZIP code, so do not promise a callback.\nRequires name, phone, ZIP, and the person's explicit consent. Tell the person details\nmay be shared with Polyares and its service-provider partners, and Polyares, those\npartners, or Zaptu may call or text about this request. Never place a call for them.\n",
      "inputSchema": {
        "properties": {
          "service_type": {
            "description": "Type of local service requested.",
            "enum": [
              "house_cleaning",
              "deep_cleaning",
              "move_in_out_cleaning",
              "recurring_cleaning",
              "pest_control",
              "garage_door",
              "plumbing",
              "hvac",
              "handyman",
              "other"
            ],
            "title": "Service Type",
            "type": "string"
          },
          "zip_code": {
            "description": "US 5-digit ZIP for the job site.",
            "title": "Zip Code",
            "type": "string"
          },
          "customer_name": {
            "description": "Customer's full name.",
            "title": "Customer Name",
            "type": "string"
          },
          "customer_phone": {
            "description": "US phone number for follow-up contact about this request.",
            "title": "Customer Phone",
            "type": "string"
          },
          "consent_to_contact": {
            "description": "Must be true: the person agreed that details may be shared with Polyares and its service-provider partners, and that Polyares, those partners, or Zaptu may call or text about this request.",
            "title": "Consent To Contact",
            "type": "boolean"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "City"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "2-letter US state code.",
            "title": "State"
          },
          "address_line": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address Line"
          },
          "bedrooms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bedrooms"
          },
          "bathrooms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bathrooms"
          },
          "square_feet": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Square Feet"
          },
          "home_type": {
            "anyOf": [
              {
                "enum": [
                  "apartment",
                  "condo",
                  "townhouse",
                  "single_family",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Home Type"
          },
          "frequency": {
            "default": "one_time",
            "enum": [
              "one_time",
              "weekly",
              "biweekly",
              "monthly"
            ],
            "title": "Frequency",
            "type": "string"
          },
          "preferred_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Preferred date as YYYY-MM-DD, if any.",
            "title": "Preferred Date"
          },
          "flexible_dates": {
            "default": true,
            "title": "Flexible Dates",
            "type": "boolean"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "What the person needs, in their words.",
            "title": "Notes"
          },
          "customer_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Customer Email"
          },
          "source_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "mcp",
            "description": "Your agent or product name.",
            "title": "Source Agent"
          },
          "dry_run": {
            "default": false,
            "description": "Validate only; nothing is saved or passed along.",
            "title": "Dry Run",
            "type": "boolean"
          }
        },
        "required": [
          "service_type",
          "zip_code",
          "customer_name",
          "customer_phone",
          "consent_to_contact"
        ],
        "title": "request_home_serviceArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "request_home_serviceOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
